{
  "name": "playwright-saucedemo-framework",
  "version": "1.0.0",
  "description": "End-to-end test automation framework built with Playwright + TypeScript using the Page Object Model, with CI/CD on GitHub Actions.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:strict": "cross-env SELF_HEALING=false playwright test --grep-invert @healing",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "codegen": "playwright codegen https://www.saucedemo.com"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "page-object-model",
    "test-automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
